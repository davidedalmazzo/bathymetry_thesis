* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.ascii text eol=lf
*.das text eol=lf
*.dds text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.npz binary

# Preserve exact artifact bytes: Block32 manifests use SHA256, including EOLs.
Block32_frf_client/** -text
